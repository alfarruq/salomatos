# §13.6 — EVERY VITE_* variable is written into the bundle as plain text and is
# readable by anyone who opens DevTools. Nothing secret belongs in this file.
# Payments, SMS, email and any third-party API are proxied through Django.

# Same-origin behind nginx (§1.2). Keep it relative — an absolute URL would
# reintroduce CORS and cross-site cookies.
VITE_API_URL=/api

# A Sentry DSN is public by design; it identifies a project, it does not grant
# access. Leave empty to disable error reporting locally.
VITE_SENTRY_DSN=
