# §13.6 — EVERY VITE_* variable is written into the bundle as plain text and is
# readable by anyone who opens DevTools. Nothing secret belongs in this file.
# Payments, SMS, email and any third-party API are proxied through Django.

# Same-origin behind nginx (§1.2). The HTTP client derives this from the page
# origin at runtime, so there is no way to point it at another host.
VITE_API_URL=/api

# A Sentry DSN is public by design; it identifies a project, it does not grant
# access. Leave empty to disable error reporting locally.
VITE_SENTRY_DSN=

# Runs the app against the MSW mock backend instead of Django. Dev builds only —
# the guard in mocks/browser.ts refuses to start in a production build, because
# a mock backend that shipped would serve fabricated patient data as if it were
# real. Set to `true` while the backend is still being built.
VITE_USE_MOCKS=false
